<h2>Mer info om:
  <%= @fruit["name"] %>
</h2>

<ul>
  <li>
    Tastiness:
    <%= @fruit["tastiness"] %>
    / 10
    <br>
    <%= stars = ""
    @fruit["tastiness"].times { stars += "★" }
    stars %>
    <%= empty = ""
    (10 - @fruit["tastiness"]).times { empty += "☆" }
    empty %>
  </li>
  <li>
    <%= @fruit["description"] %>
  </li>
</ul>

